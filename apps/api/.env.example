# Tandem server environment. NOTHING here is required: a bare `tandem` (or
# `npx @jaximus/tandem-mcp up`) starts in local mode with everything under
# ~/.tandem. Copy to .env only to change something.

# ── Local mode (the default) ─────────────────────────────────────────────────

# Auth posture: "none" (local — one machine, one user, no sign-in) or "google"
# (self-hosted with Google sign-in; see the section below).
# TANDEM_AUTH=none

# Where the SQLite database, the auto-generated JWT secret, uploaded images and
# logs live. Default ~/.tandem.
# TANDEM_DATA_DIR=~/.tandem

# SQLite file. Default <TANDEM_DATA_DIR>/tandem.db. ":memory:" = throwaway board.
# TANDEM_DB=

# HTTP port (default 7891). `tandem-mcp up --port` sets the same thing.
# PORT=7891

# Serve the web app from a directory instead of the bundle embedded in the
# binary — the dev loop (`pnpm --filter web build`, then point at its dist).
# WEB_DIST_PATH=../../apps/web/dist

# Uploaded images. Default <TANDEM_DATA_DIR>/images.
# IMAGE_DIR=

# Signs canvas tokens + sessions. Unset = read from / generated into
# <TANDEM_DATA_DIR>/secret on first run, so tokens survive restarts.
# JWT_SECRET=

# Canvas token lifetime (Go duration). Default 24h.
# JWT_TOKEN_TTL=24h

# Minutes an 'executing' task claim is honored before it counts as stuck and
# the next task_claim may atomically take it over (lazy expiry — no background
# job). Default 15; 0 disables expiry entirely.
# CLAIM_TTL_MINUTES=15

# Outbound-webhook delivery worker (what `tandem-mcp listen` receives from).
# Enabled by default.
# WEBHOOKS_ENABLED=true

# Whether webhooks may target loopback / private addresses. In LOCAL mode this
# defaults to ON (the receiver is a `tandem-mcp listen` on this machine);
# set 0/false to turn the SSRF guard back on. Under TANDEM_AUTH=google it is a
# strict opt-in (only "1"/"true" enable it) — never enable it on a server other
# people can reach: any canvas editor could then point the server at your
# internal network, including a cloud metadata endpoint.
# TANDEM_WEBHOOKS_ALLOW_PRIVATE=

# Agent transcripts (local mode only): the board can show each Tandem agent's
# Claude Code session live, read from ~/.claude/projects/**.jsonl via
# GET /api/canvas/agents/{agentId}/transcript. Never served under
# TANDEM_AUTH=google (403 transcripts_local_only) — a self-hosted server must not
# expose its operator's files. Set off/0/false to disable it locally too.
# TANDEM_TRANSCRIPTS=on

# The Claude Code config dir whose projects/ folder holds the transcripts.
# Default: CLAUDE_CONFIG_DIR if set, else ~/.claude. A path ending in
# "projects" is taken as the projects folder itself.
# TANDEM_CLAUDE_DIR=~/.claude

# GET /api/metrics — live in-memory latency/queue aggregates. Default on.
# METRICS_ENABLED=true

# Optional GitHub token for the READ-ONLY status proxy that resolves the
# commit / PR links a task completion carries into a live state on the board.
# Unauthenticated = 60 requests/hour per IP; with a public-read fine-grained
# token, 5,000. Never a token that can read private repos (it is refused).
# GH_STATUS_TOKEN=

# ── Self-hosting with sign-in (TANDEM_AUTH=google) ───────────────────────────
# Turns on Google sign-in, accounts, personal access tokens, canvas sharing and
# the OAuth step-up for hosted MCP connectors. The web bundle must be built
# with the same client id as VITE_GOOGLE_CLIENT_ID (see Dockerfile).

# TANDEM_AUTH=google
# GOOGLE_CLIENT_ID=            # console.cloud.google.com → OAuth client (Web)
# PUBLIC_BASE_URL=https://tandem.example.com   # OAuth issuer + metadata URLs
# COOKIE_SECURE=true           # https only; leave unset on plain http
